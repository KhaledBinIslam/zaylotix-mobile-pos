# Production environment template for Zaylotix POS.
#
# This is NOT the file the app reads — it's a starting point. On the live
# server, copy this to `.env`, fill in the placeholders below (marked
# CHANGE-ME), then run `php artisan key:generate` (do NOT reuse the dev
# APP_KEY — it decrypts session/cookie data, a fresh one is required).
#
# Everything not called out below is safe to leave as-is from .env.example.

APP_NAME="Zaylotix POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE-ME.example.com

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' is fine for local dev but writes a lot to disk fast on a live
# server under real traffic — 'error' still catches everything that
# actually needs attention.
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE-ME
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS is force-enabled by AppServiceProvider when APP_ENV=production —
# this makes the session cookie itself refuse to ever travel over plain
# HTTP too, not just redirect to HTTPS after the fact.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# zaylotix:backup writes here. 'local' is fine if the host's disk is backed
# up separately; switch to 's3' (and fill in the AWS_* vars above) for an
# off-server copy shared hosting can't touch.
BACKUP_DISK=local

VITE_APP_NAME="${APP_NAME}"

# --- One-time setup on the server, after this file is in place as .env ---
# php artisan key:generate
# composer install --no-dev --optimize-autoloader
# php artisan migrate --force
# php artisan storage:link
# php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# --- Cron (runs every scheduled job: payment reminders, subscription
#     expiry, low-stock/expiry alerts, nightly backup) ---
# * * * * * php /full/path/to/artisan schedule:run >> /dev/null 2>&1
