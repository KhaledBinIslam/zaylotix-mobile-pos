# Deploy করার template — .env নামে কপি করে নিচের ৩টা জায়গা পূরণ করো
# (APP_KEY একটা কমান্ড দিয়ে জেনারেট হবে, DB_* এর ৩টা লাইন hPanel থেকে পাওয়া তথ্য
# দিয়ে) — বাকি সব লাইন এভাবেই রেখে দাও।
#
# cp .env.production.example .env

APP_NAME="Zaylotix POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.zaylotix.com

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' লোকাল ডেভেলপমেন্টে ঠিক আছে, কিন্তু লাইভ সার্ভারে রিয়েল ট্র্যাফিকে
# ডিস্কে অনেক লগ লিখে ফেলে — 'error' হলে যা আসলে গুরুত্বপূর্ণ সেটাই ধরা পড়ে।
LOG_LEVEL=error

# ↓↓↓ hPanel → Databases থেকে পাওয়া তথ্য দিয়ে এই ৩টা পূরণ করো ↓↓↓
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# APP_ENV=production হলে AppServiceProvider নিজে থেকেই HTTPS force করে —
# এটা সেশন কুকিকেও প্লেইন HTTP-তে কখনো না যাওয়ার জন্য বাধ্য করে।
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# zaylotix:backup এখানে লিখবে। 'local' ঠিক আছে যদি হোস্টের ডিস্ক আলাদাভাবে
# ব্যাকআপ হয়; পরে দরকার হলে 's3'-এ পাল্টানো যাবে (উপরের AWS_* পূরণ করে)।
BACKUP_DISK=local

VITE_APP_NAME="${APP_NAME}"

# --- এই ফাইলটা .env হিসেবে বসানোর পর, সার্ভারে একবার এই কমান্ডগুলো (এক block-এ) ---
# php artisan key:generate
# composer install --no-dev --optimize-autoloader
# php artisan migrate --force
# php artisan storage:link
# php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# --- Cron job (hPanel → Cron Jobs, প্রতি মিনিটে) — সব scheduled কাজ চালায়:
#     payment reminder, subscription expiry, low-stock/expiry অ্যালার্ট, নাইটলি ব্যাকআপ ---
# * * * * * php /full/path/to/artisan schedule:run >> /dev/null 2>&1
